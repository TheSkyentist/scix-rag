*.pyc

# Ephemeral fetch/convert caches -- regenerated fresh each run from
# papers.duckdb's pending status columns, not meant to persist.
data/html/
data/markdown/
data/pdf/

# The corpus database (papers, citation edges, chunks, embeddings) is multi-GB and
# lives only on disk: never commit it. Back it up outside git.
*.duckdb
*.duckdb.wal
