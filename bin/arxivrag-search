#!/bin/sh
# Literature search over the local arXivRAG index (src/search.py). Runs the `search`
# pixi environment's python directly: no pixi startup, no re-solve, and no task-shell
# re-parsing of arguments (bibcodes contain '&'). Works from any directory.
# Usage: arxivrag-search {search|chunk|paper|grep|status} ...   (see --help)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$ROOT/.pixi/envs/search/bin/python"
if [ ! -x "$PY" ]; then
    echo "search environment missing: run 'pixi install -e search' in $ROOT" >&2
    exit 3
fi
cd "$ROOT" && exec "$PY" -m src.search "$@"
